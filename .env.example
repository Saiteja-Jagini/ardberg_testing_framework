# Copy this file to .env, then provide your own credentials.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

DATABASE_URL=postgresql+psycopg://ardberg:ardberg_local@127.0.0.1:5432/ardberg
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_TASK_QUEUE=ardberg-runs
FRONTEND_ORIGIN=http://127.0.0.1:3000
PUBLIC_DASHBOARD_URL=
RUNNER_IMAGE=ardberg-runner:local
POSTGRES_TEST_IMAGE=postgres:16-alpine
RUNNER_MEMORY=5g
RUNNER_CPUS=4
RUNNER_PIDS_LIMIT=1024
NPM_REGISTRY_URL=https://registry.npmjs.org/
PIP_INDEX_URL=https://pypi.org/simple
MAX_ARCHIVE_BYTES=52428800
MAX_EXTRACTED_BYTES=262144000
MAX_ARCHIVE_MEMBER_BYTES=104857600
